<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Edit your message</title>
</head>
<body>
    <p>edit your chat for: <%= chat._id %></p>
    <p>This message was sent from <%= chat.from %> to <%= chat.to %></p>
    <form method= "POST" action="/chats/<%=chat._id%>?_method=PUT">
        <textarea name="msg" rows="10" column="10"><%= chat.msg %></textarea>
        <button>edit</button>
    </form>
</body>
</html>